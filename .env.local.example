# =============================================================================
# FWD Marketplace · variables de entorno
# =============================================================================
# Copiá este archivo a `.env.local` y completá los valores.
# `.env.local` NUNCA se sube a git (está en .gitignore).
#
# Referencia completa en README.md, sección "Variables de entorno".
# =============================================================================


# -------- Supabase (obligatorio) ---------------------------------------------
# Las dos primeras vars son públicas (prefijo NEXT_PUBLIC_) y viajan al cliente.
# La service role key es server-only: NUNCA se importa desde un Client Component
# ni se referencia en código bajo `'use client'`.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# -------- IA (opcional · features 2.0) ---------------------------------------
# Usadas solo si el equipo implementa matching algorítmico, sugerencias de
# pricing o autocompletar copy. Nunca para generar postulaciones de juniors.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=


# -------- Email (opcional) ---------------------------------------------------
# Resend para notificaciones transaccionales (postulación recibida, etc.).
# Solo si el equipo decide implementar notificaciones por correo.

RESEND_API_KEY=
