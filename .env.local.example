# ─────────────────────────────────────────────────────────────────────────────
# Marketplace FWD — contrato de variables de entorno
#
# Cómo usar:
#   cp .env.local.example .env.local
#   y completar con las llaves reales (las comparte el equipo).
#
# Reglas:
#   - .env.local NUNCA se commitea (está en .gitignore). Este .example SÍ.
#   - Toda variable NEXT_PUBLIC_* se expone al navegador. No poner secretos ahí.
#   - Las variables sin prefijo NEXT_PUBLIC_ son SOLO servidor.
#   - reglas.md §"Zod en todas las fronteras": estas vars deben validarse con Zod
#     antes de usarse (validador pendiente).
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase — REQUERIDAS (MVP) ──────────────────────────────────────────────
# URL del proyecto Supabase del equipo. Pública (va al cliente).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública (anon). Va al cliente; queda sometida a RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# Clave de servicio. SOLO servidor, jamás exponer al cliente (reglas.md §115, §13 FAQ).
# Saltea RLS: si se filtra, se compromete toda la base.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key


# ── IA — Agente de proyectos (feature new-project, 2.4 + 2.10) ───────────────
# El agente conversacional de publicación de proyectos usa OpenAI.
# Solo servidor (sin prefijo NEXT_PUBLIC_): NUNCA exponer al cliente.
# reglas.md §"Zod en todas las fronteras": validar estas vars con Zod antes de usar.

# Llave de OpenRouter (API OpenAI-compatible). REQUERIDA para el agente IA.
# La key es de openrouter.ai (NO de platform.openai.com).
# Obtenela en https://openrouter.ai/keys y pegá el valor real en .env.local.
OPENAI_API_KEY=

# Modelo a usar (slug de OpenRouter). Se registra en conversaciones_ia.modelo_ia.
OPENAI_MODEL=openai/gpt-oss-120b

# Base URL del gateway OpenAI-compatible. OpenRouter es el proveedor activo.
OPENAI_BASE_URL=https://openrouter.ai/api/v1


# ── IA — Claude (Anthropic), RESERVADO para uso futuro ───────────────────────
# Espacio preparado por si el módulo lib/ai se cambia a Claude. Hoy sin uso en código.
# Solo servidor. Dejar vacío mientras el proveedor activo sea OpenAI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=


# ── Email — OPCIONAL ─────────────────────────────────────────────────────────
# Envío de correos transaccionales (Resend). Solo servidor. Aún sin uso en código.
RESEND_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# NOTA — Google OAuth:
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET NO van aquí. Con Supabase Auth, el
#   login con Google se configura en el dashboard de Supabase
#   (Authentication → Providers → Google). La app solo invoca el OAuth de
#   Supabase y nunca lee esas variables. Por eso se omiten de este contrato.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# NOTA — GitHub OAuth:
#   Igual que Google: GITHUB_CLIENT_ID / SECRET NO van aquí. El login con GitHub
#   se configura en el dashboard de Supabase (Authentication → Providers →
#   GitHub) con las llaves de una OAuth App de GitHub. La app solo invoca el
#   OAuth de Supabase. La "Authorization callback URL" de la OAuth App de GitHub
#   (y el "Authorized redirect URI" de Google) deben apuntar al callback de
#   Supabase: https://<TU-PROYECTO>.supabase.co/auth/v1/callback
#   Las "Redirect URLs" de Supabase (Authentication → URL Configuration) deben
#   incluir la URL de la app: http://localhost:3000/auth/callback (dev).
# ─────────────────────────────────────────────────────────────────────────────
